# scripts/init_env.py erzeugt sichere lokale Werte. Nicht ins Repository einchecken.
APP_URL=http://localhost:8765
APP_PASSWORD=
ENCRYPTION_KEY=
DATA_DIR=./data
# HTTPS in Produktion zwingend; Cookie-Sicherheit wird aus APP_URL abgeleitet.
# Vor Google-Anmeldung die ausdrücklich berechtigte Google-Adresse eintragen.
GOOGLE_ALLOWED_EMAIL=
APP_USERNAME=owner
OPENROUTER_API_KEY=
